<Window x:Class="Bio_Athun_System.Views.loginFaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BioAuth System" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E1B"
        WindowStyle="None"
        AllowsTransparency="True">

    <Grid Background="#0B0E1B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="30,20,30,0">
            <TextBlock Text="Face Recognition Login" 
                       FontSize="28" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center" 
                       Foreground="#358DE6" 
                       Margin="0,10,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#358DE6"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.6" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="lblStatus" 
                       Text="Position your face within the circle to authenticate"
                       Foreground="#8E94B7" FontSize="14" Margin="0,5,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="450" Height="350" CornerRadius="15" BorderBrush="#6A5ACD" BorderThickness="3">
                <Border.Effect>
                    <DropShadowEffect Color="#6A5ACD" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <Image x:Name="CameraPreview" 
               Stretch="UniformToFill" 
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality">
                    </Image>

                    <Rectangle x:Name="ScannerFrame" Stroke="#358DE6" StrokeThickness="2" Margin="20" Opacity="0.3">
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.1" To="0.8" Duration="0:0:1" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>
            </Border>

            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,30">
                <TextBlock x:Name="txtScanning" Text="ANALYZING BIOMETRICS..." 
                           Foreground="#6A5ACD" 
                           HorizontalAlignment="Center" 
                           FontWeight="Bold" 
                           FontSize="12" />

                <ProgressBar x:Name="prgLoading" 
                             Width="180" Height="4" 
                             Margin="0,10,0,0" 
                             Background="#1A1D33" 
                             Foreground="#358DE6" 
                             BorderThickness="0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="30,0,30,40">
            <Button x:Name="btnBack" Content="Back" Width="100" Height="45" 
                    HorizontalAlignment="Left"
                    Background="#6A5ACD" Foreground="White" FontWeight="Bold" Click="btnBack_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Content="Cancel" Width="120" Height="45" 
                        Background="Transparent" Foreground="#8E94B7" BorderBrush="#212745" 
                        Margin="0,0,15,0" Click="btnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnStartCapture" Content="Identify Face" 
                        Click="btnStartCapture_Click" Width="150" Height="45" 
                        Background="#6A5ACD" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>