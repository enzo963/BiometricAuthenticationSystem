<Window x:Class="Bio_Athun_System.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BioAuth Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#0A0E1A"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="#8E94B7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="10" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F243D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#606060"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding [الحالة]}" Value="✘  مرفوض">
                    <Setter Property="Foreground" Value="#FF4560"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [تنبيه]}" Value="⚠ مشبوه">
                    <Setter Property="Background" Value="#1A0808"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border CornerRadius="20" Background="#0F1629" BorderBrush="#212745" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ SIDEBAR ══════════ -->
            <Border Grid.Column="0" Background="#0D1224" CornerRadius="20,0,0,20">
                <StackPanel Margin="20,40,20,30">

                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                        <Border Width="85" Height="85" CornerRadius="45"
                                BorderBrush="#4E46B4" BorderThickness="2" Margin="0,0,0,15">
                            <Grid>
                                <TextBlock Text="👤" FontSize="45"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#4E46B4"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="lblUserName"
                                   Text="..." Foreground="White"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="lblUserRole"
                                   Text="..." Foreground="#4E46B4"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#212745" Margin="15,0,15,30"/>

                    <RadioButton Style="{StaticResource MenuButtonStyle}"
                                 Content="System Overview" IsChecked="True"/>

                    <RadioButton x:Name="btnEnrollFace"
                                 Style="{StaticResource MenuButtonStyle}"
                                 Content="Enroll New Face"
                                 Click="btnEnrollFace_Click" Checked="btnEnrollFace_Checked">
                        <RadioButton.Effect>
                            <DropShadowEffect Color="#6A5ACD" BlurRadius="12"
                                              Opacity="0.4" ShadowDepth="0"/>
                        </RadioButton.Effect>
                    </RadioButton>

                    <RadioButton Style="{StaticResource MenuButtonStyle}" Content="Access Logs"/>
                    <RadioButton Style="{StaticResource MenuButtonStyle}"
                                 Content="Database Settings" Margin="0,0,0,80"/>

                    <Button Content="Sign Out"
                            Foreground="#5D73FF" Background="Transparent"
                            BorderThickness="0" HorizontalAlignment="Center"
                            Click="Logout_Click" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- ══════════ MAIN CONTENT ══════════ -->
            <Grid Grid.Column="1" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- أزرار إغلاق / تصغير -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,-15,0" Panel.ZIndex="10">
                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="—" FontSize="14"
                            Margin="0,0,5,0" Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource ControlButtonStyle}"
                            Content="✕" FontSize="16" Click="BtnClose_Click"/>
                </StackPanel>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock x:Name="txtWelcome"
                                   Text="Welcome back, Admin"
                                   FontSize="28" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="System status: Secure and operational"
                                   Foreground="#606060" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="45" Height="45" CornerRadius="22" Background="#161B30">
                            <TextBlock x:Name="txtAvatarLetter"
                                       Text="A" Foreground="#6A5ACD"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══════════ البطاقات الثلاث ══════════ -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,30">

                    <!-- بطاقة 1: المستخدمون -->
                    <Border Margin="0,0,10,0" Background="#161B30" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="المستخدمين المسجلين"
                                       Foreground="#8E94B7" FontSize="14" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtTotalUsers"
                                       Text="..." Foreground="White"
                                       FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="txtNewThisWeek"
                                       Text="..." Foreground="#00FF7F"
                                       FontSize="11" Margin="0,5,0,0"/>
                            <Rectangle Height="2" Fill="#4E46B4"
                                       Margin="0,10,0,0" HorizontalAlignment="Left" Width="50"/>
                        </StackPanel>
                    </Border>

                    <!-- بطاقة 2: دقة التعرف -->
                    <Border Margin="0,0,10,0" Background="#161B30" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="دقة التعرف (FAR/FRR)"
                                       Foreground="#8E94B7" FontSize="14" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtAccuracy"
                                       Text="..." Foreground="#00BFFF"
                                       FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock Text="آخر 1000 محاولة"
                                       Foreground="#8E94B7" FontSize="11" Margin="0,5,0,0"/>
                            <Rectangle Height="2" Fill="#00BFFF"
                                       Margin="0,10,0,0" HorizontalAlignment="Left" Width="50"/>
                        </StackPanel>
                    </Border>

                    <!-- بطاقة 3: المرفوضات -->
                    <Border Background="#161B30" CornerRadius="15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="محاولات مرفوضة (آخر 24 ساعة)"
                                       Foreground="#8E94B7" FontSize="14" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="txtRejected"
                                       Text="..." Foreground="#FF4560"
                                       FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="txtSuspicious"
                                       Text="..." Foreground="#FF4560"
                                       FontSize="11" Margin="0,5,0,0"/>
                            <Rectangle Height="2" Fill="#FF5D5D"
                                       Margin="0,10,0,0" HorizontalAlignment="Left" Width="50"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ══════════ جدول السجلات ══════════ -->
                <Border Grid.Row="2" Background="#161B30" CornerRadius="15" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Recent Access Logs"
                                   Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <DataGrid x:Name="dgAccessLogs"
                                  Grid.Row="1"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="White" RowBackground="Transparent"
                                  AlternatingRowBackground="#0D1224"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#212745"
                                  IsReadOnly="True" AutoGenerateColumns="True"
                                  CanUserResizeRows="False" SelectionMode="Single"
                                  RowStyle="{StaticResource LogRowStyle}"
                                  Panel.ZIndex="1">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1F243D"/>
                                    <Setter Property="Foreground" Value="#8E94B7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <TextBlock x:Name="lblNoData"
                                   Grid.Row="1"
                                   Text="No recent activity to display."
                                   Foreground="#606060"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   Panel.ZIndex="0"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>

</Window>
